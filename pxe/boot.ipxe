#!ipxe

dhcp
set base http://10.0.0.1:9000/porteus

echo Booting Porteus Kiosk from ${base}

kernel ${base}/vmlinuz kiosk_config=${base}/kiosk.cfg from=${base} ramdisk_size=500000

initrd ${base}/initrd.xz

imgfetch ${base}/base/000-kernel.xzm
imgfetch ${base}/base/001-core.xzm
imgfetch ${base}/base/002-firefox.xzm
imgfetch ${base}/base/003-settings.xzm

boot

