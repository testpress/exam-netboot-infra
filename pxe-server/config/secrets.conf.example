# ═══════════════════════════════════════════════════════════════════════════════
# PXE Server Secrets
# ═══════════════════════════════════════════════════════════════════════════════
#
# This file contains sensitive credentials.
#
# IMPORTANT SECURITY STEPS:
#   1. Copy to /etc/pxe-server/secrets.conf
#   2. Set restrictive permissions: sudo chmod 600 /etc/pxe-server/secrets.conf
#   3. NEVER commit this file with real credentials to version control
#
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# WiFi Credentials for Kiosk Auto-Connect
# ───────────────────────────────────────────────────────────────────────────────

# WiFi network name (SSID)
KIOSK_SSID="YourNetworkSSID"

# WiFi password
KIOSK_PASSWORD="YourSecurePassword"

# ───────────────────────────────────────────────────────────────────────────────
# Additional Secrets (if needed)
# ───────────────────────────────────────────────────────────────────────────────

# Add any additional sensitive configuration here
# Examples:
#   API_KEY="your-api-key"
#   ADMIN_PASSWORD="your-admin-password"
